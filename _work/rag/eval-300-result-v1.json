   "citations": [
    {
     "lawId": "CN-FIL-REG-2019",
     "lawTitle": {
      "zh": "中华人民共和国外商投资法实施条例",
      "en": "Regulations for the Implementation of the Foreign Investment Law of the People's Republic of China",
      "orig": "中华人民共和国外商投资法实施条例"
     },
     "country": "CN",
     "no": 4,
     "noLabel": "第四条",
     "heading": "",
     "text": {
      "zh": "外商投资准入负面清单（以下简称负面清单）由国务院投资主管部门会同国务院商务主管部门等有关部门提出，报国务院发布或者报国务院批准后由国务院投资主管部门、商务主管部门发布。\n国家根据进一步扩大对外开放和经济社会发展需要，适时调整负面清单。调整负面清单的程序，适用前款规定。"
     },
     "score": 0.031778,
     "debug": {
      "bm25Rank": 5,
      "vecRank": 1,
      "cosine": 0.7823
     }
    },
    {
     "lawId": "CN-FIL-2019",
     "lawTitle": {
      "zh": "中华人民共和国外商投资法",
      "en": "Foreign Investment Law of the People's Republic of China",
      "orig": "中华人民共和国外商投资法"
     },
     "country": "CN",
     "no": 28,
     "noLabel": "第二十八条",
     "heading": "",
     "text": {
      "zh": "外商投资准入负面清单规定禁止投资的领域，外国投资者不得投资。\n外商投资准入负面清单规定限制投资的领域，外国投资者进行投资应当符合负面清单规定的条件。\n外商投资准入负面清单以外的领域，按照内外资一致的原则实施管理。"
     },
     "score": 0.031754,
