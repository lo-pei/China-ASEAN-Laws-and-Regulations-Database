  {
   "id": "CN-JI-0168-A1",
   "no": 1,
   "noLabel": {
    "zh": "一、"
   },
   "text": {
    "zh": "海事侵权纠纷案件"
   }
  },
  {
   "id": "CN-JI-0168-A1_2",
   "no": 1,
   "noLabel": {
    "zh": "1、"
   },
   "text": {
    "zh": "船舶碰撞损害责任纠纷案件，包括浪损等间接碰撞的损害责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A2",
   "no": 2,
   "noLabel": {
    "zh": "2、"
   },
   "text": {
    "zh": "船舶触碰海上、通海可航水域、港口及其岸上的设施或者其他财产的损害责任纠纷案件，包括船舶触碰码头、防波堤、栈桥、船闸、桥梁、航标、钻井平台等设施的损害责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A3",
   "no": 3,
   "noLabel": {
    "zh": "3、"
   },
   "text": {
    "zh": "船舶损坏在空中架设或者在海底、通海可航水域敷设的设施或者其他财产的损害责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A4",
   "no": 4,
   "noLabel": {
    "zh": "4、"
   },
   "text": {
    "zh": "船舶排放、泄漏、倾倒油类、污水或者其他有害物质，造成水域污染或者他船、货物及其他财产损失的损害责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A5",
   "no": 5,
   "noLabel": {
    "zh": "5、"
   },
   "text": {
    "zh": "船舶的航行或者作业损害捕捞、养殖设施及水产养殖物的责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A6",
   "no": 6,
   "noLabel": {
    "zh": "6、"
   },
   "text": {
    "zh": "航道中的沉船沉物及其残骸、废弃物，海上或者通海可航水域的临时或者永久性设施、装置，影响船舶航行，造成船舶、货物及其他财产损失和人身损害的责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A7",
   "no": 7,
   "noLabel": {
    "zh": "7、"
   },
   "text": {
    "zh": "船舶航行、营运、作业等活动侵害他人人身权益的责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A8",
   "no": 8,
   "noLabel": {
    "zh": "8、"
   },
   "text": {
    "zh": "非法留置或者扣留船舶、船载货物和船舶物料、燃油、备品的责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A9",
   "no": 9,
   "noLabel": {
    "zh": "9、"
   },
   "text": {
    "zh": "为船舶工程提供的船舶关键部件和专用物品存在缺陷而引起的产品质量责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A10",
   "no": 10,
   "noLabel": {
    "zh": "10、"
   },
   "text": {
    "zh": "其他海事侵权纠纷案件。"
   }
  },
  {
   "id": "CN-JI-0168-A2_2",
   "no": 2,
   "noLabel": {
    "zh": "二、"
   },
   "text": {
    "zh": "海商合同纠纷案件"
   }
  },
  {
   "id": "CN-JI-0168-A11",
   "no": 11,
   "noLabel": {
    "zh": "11、"
   },
   "text": {
    "zh": "船舶买卖合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A12",
   "no": 12,
   "noLabel": {
    "zh": "12、"
   },
   "text": {
    "zh": "船舶工程合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A13",
   "no": 13,
   "noLabel": {
    "zh": "13、"
   },
   "text": {
    "zh": "船舶关键部件和专用物品的分包施工、委托建造、订制、买卖等合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A14",
   "no": 14,
   "noLabel": {
    "zh": "14、"
   },
   "text": {
    "zh": "船舶工程经营合同（含挂靠、合伙、承包等形式）纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A15",
   "no": 15,
   "noLabel": {
    "zh": "15、"
   },
   "text": {
    "zh": "船舶检验合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A16",
   "no": 16,
   "noLabel": {
    "zh": "16、"
   },
   "text": {
    "zh": "船舶工程场地租用合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A17",
   "no": 17,
   "noLabel": {
    "zh": "17、"
   },
   "text": {
    "zh": "船舶经营管理合同（含挂靠、合伙、承包等形式）、航线合作经营合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A18",
   "no": 18,
   "noLabel": {
    "zh": "18、"
   },
   "text": {
    "zh": "与特定船舶营运相关的物料、燃油、备品供应合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A19",
   "no": 19,
   "noLabel": {
    "zh": "19、"
   },
   "text": {
    "zh": "船舶代理合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A20",
   "no": 20,
   "noLabel": {
    "zh": "20、"
   },
   "text": {
    "zh": "船舶引航合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A21",
   "no": 21,
   "noLabel": {
    "zh": "21、"
   },
   "text": {
    "zh": "船舶抵押合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A22",
   "no": 22,
   "noLabel": {
    "zh": "22、"
   },
   "text": {
    "zh": "船舶租用合同（含定期租船合同、光船租赁合同等）纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A23",
   "no": 23,
   "noLabel": {
    "zh": "23、"
   },
   "text": {
    "zh": "船舶融资租赁合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A24",
   "no": 24,
   "noLabel": {
    "zh": "24、"
   },
   "text": {
    "zh": "船员劳动合同、劳务合同（含船员劳务派遣协议）项下与船员登船、在船服务、离船遣返相关的报酬给付及人身伤亡赔偿纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A25",
   "no": 25,
   "noLabel": {
    "zh": "25、"
   },
   "text": {
    "zh": "海上、通海可航水域货物运输合同纠纷案件，包括含有海运区段的国际多式联运、水陆联运等货物运输合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A26",
   "no": 26,
   "noLabel": {
    "zh": "26、"
   },
   "text": {
    "zh": "海上、通海可航水域旅客和行李运输合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A27",
   "no": 27,
   "noLabel": {
    "zh": "27、"
   },
   "text": {
    "zh": "海上、通海可航水域货运代理合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A28",
   "no": 28,
   "noLabel": {
    "zh": "28、"
   },
   "text": {
    "zh": "海上、通海可航水域运输集装箱租用合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A29",
   "no": 29,
   "noLabel": {
    "zh": "29、"
   },
   "text": {
    "zh": "海上、通海可航水域运输理货合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A30",
   "no": 30,
   "noLabel": {
    "zh": "30、"
   },
   "text": {
    "zh": "海上、通海可航水域拖航合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A31",
   "no": 31,
   "noLabel": {
    "zh": "31、"
   },
   "text": {
    "zh": "轮渡运输合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A32",
   "no": 32,
   "noLabel": {
    "zh": "32、"
   },
   "text": {
    "zh": "港口货物堆存、保管、仓储合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A33",
   "no": 33,
   "noLabel": {
    "zh": "33、"
   },
   "text": {
    "zh": "港口货物抵押、质押等担保合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A34",
   "no": 34,
   "noLabel": {
    "zh": "34、"
   },
   "text": {
    "zh": "港口货物质押监管合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A35",
   "no": 35,
   "noLabel": {
    "zh": "35、"
   },
   "text": {
    "zh": "海运集装箱仓储、堆存、保管合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A36",
   "no": 36,
   "noLabel": {
    "zh": "36、"
   },
   "text": {
    "zh": "海运集装箱抵押、质押等担保合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A37",
   "no": 37,
   "noLabel": {
    "zh": "37、"
   },
   "text": {
    "zh": "海运集装箱融资租赁合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A38",
   "no": 38,
   "noLabel": {
    "zh": "38、"
   },
   "text": {
    "zh": "港口或者码头租赁合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A39",
   "no": 39,
   "noLabel": {
    "zh": "39、"
   },
   "text": {
    "zh": "港口或者码头经营管理合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A40",
   "no": 40,
   "noLabel": {
    "zh": "40、"
   },
   "text": {
    "zh": "海上保险、保赔合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A41",
   "no": 41,
   "noLabel": {
    "zh": "41、"
   },
   "text": {
    "zh": "以通海可航水域运输船舶及其营运收入、货物及其预期利润、船员工资和其他报酬、对第三人责任等为保险标的的保险合同、保赔合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A42",
   "no": 42,
   "noLabel": {
    "zh": "42、"
   },
   "text": {
    "zh": "以船舶工程的设备设施以及预期收益、对第三人责任为保险标的的保险合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A43",
   "no": 43,
   "noLabel": {
    "zh": "43、"
   },
   "text": {
    "zh": "以港口生产经营的设备设施以及预期收益、对第三人责任为保险标的的保险合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A44",
   "no": 44,
   "noLabel": {
    "zh": "44、"
   },
   "text": {
    "zh": "以海洋渔业、海洋开发利用、海洋工程建设等活动所用的设备设施以及预期收益、对第三人的责任为保险标的的保险合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A45",
   "no": 45,
   "noLabel": {
    "zh": "45、"
   },
   "text": {
    "zh": "以通海可航水域工程建设所用的设备设施以及预期收益、对第三人的责任为保险标的的保险合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A46",
   "no": 46,
   "noLabel": {
    "zh": "46、"
   },
   "text": {
    "zh": "港航设备设施融资租赁合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A47",
   "no": 47,
   "noLabel": {
    "zh": "47、"
   },
   "text": {
    "zh": "港航设备设施抵押、质押等担保合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A48",
   "no": 48,
   "noLabel": {
    "zh": "48、"
   },
   "text": {
    "zh": "以船舶、海运集装箱、港航设备设施设定担保的借款合同纠纷案件，但当事人仅就借款合同纠纷起诉的案件除外；"
   }
  },
  {
   "id": "CN-JI-0168-A49",
   "no": 49,
   "noLabel": {
    "zh": "49、"
   },
   "text": {
    "zh": "为购买、建造、经营特定船舶而发生的借款合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A50",
   "no": 50,
   "noLabel": {
    "zh": "50、"
   },
   "text": {
    "zh": "为担保海上运输、船舶买卖、船舶工程、港口生产经营相关债权实现而发生的担保、独立保函、信用证等纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A51",
   "no": 51,
   "noLabel": {
    "zh": "51、"
   },
   "text": {
    "zh": "与上述第11项至第50项规定的合同或者行为相关的居间、委托合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A52",
   "no": 52,
   "noLabel": {
    "zh": "52、"
   },
   "text": {
    "zh": "其他海商合同纠纷案件。"
   }
  },
  {
   "id": "CN-JI-0168-A3_2",
   "no": 3,
   "noLabel": {
    "zh": "三、"
   },
   "text": {
    "zh": "海洋及通海可航水域开发利用与环境保护相关纠纷案件"
   }
  },
  {
   "id": "CN-JI-0168-A53",
   "no": 53,
   "noLabel": {
    "zh": "53、"
   },
   "text": {
    "zh": "海洋、通海可航水域能源和矿产资源勘探、开发、输送纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A54",
   "no": 54,
   "noLabel": {
    "zh": "54、"
   },
   "text": {
    "zh": "海水淡化和综合利用纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A55",
   "no": 55,
   "noLabel": {
    "zh": "55、"
   },
   "text": {
    "zh": "海洋、通海可航水域工程建设（含水下疏浚、围海造地、电缆或者管道敷设以及码头、船坞、钻井平台、人工岛、隧道、大桥等建设）纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A56",
   "no": 56,
   "noLabel": {
    "zh": "56、"
   },
   "text": {
    "zh": "海岸带开发利用相关纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A57",
   "no": 57,
   "noLabel": {
    "zh": "57、"
   },
   "text": {
    "zh": "海洋科学考察相关纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A58",
   "no": 58,
   "noLabel": {
    "zh": "58、"
   },
   "text": {
    "zh": "海洋、通海可航水域渔业经营（含捕捞、养殖等）合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A59",
   "no": 59,
   "noLabel": {
    "zh": "59、"
   },
   "text": {
    "zh": "海洋开发利用设备设施融资租赁合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A60",
   "no": 60,
   "noLabel": {
    "zh": "60、"
   },
   "text": {
    "zh": "海洋开发利用设备设施抵押、质押等担保合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A61",
   "no": 61,
   "noLabel": {
    "zh": "61、"
   },
   "text": {
    "zh": "以海洋开发利用设备设施设定担保的借款合同纠纷案件，但当事人仅就借款合同纠纷起诉的案件除外；"
   }
  },
  {
   "id": "CN-JI-0168-A62",
   "no": 62,
   "noLabel": {
    "zh": "62、"
   },
   "text": {
    "zh": "为担保海洋及通海可航水域工程建设、海洋开发利用等海上生产经营相关债权实现而发生的担保、独立保函、信用证等纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A63",
   "no": 63,
   "noLabel": {
    "zh": "63、"
   },
   "text": {
    "zh": "海域使用权纠纷（含承包、转让、抵押等合同纠纷及相关侵权纠纷）案件，但因申请海域使用权引起的确权纠纷案件除外；"
   }
  },
  {
   "id": "CN-JI-0168-A64",
   "no": 64,
   "noLabel": {
    "zh": "64、"
   },
   "text": {
    "zh": "与上述第53项至63项规定的合同或者行为相关的居间、委托合同纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A65",
   "no": 65,
   "noLabel": {
    "zh": "65、"
   },
   "text": {
    "zh": "污染海洋环境、破坏海洋生态责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A66",
   "no": 66,
   "noLabel": {
    "zh": "66、"
   },
   "text": {
    "zh": "污染通海可航水域环境、破坏通海可航水域生态责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A67",
   "no": 67,
   "noLabel": {
    "zh": "67、"
   },
   "text": {
    "zh": "海洋或者通海可航水域开发利用、工程建设引起的其他侵权责任纠纷及相邻关系纠纷案件。"
   }
  },
  {
   "id": "CN-JI-0168-A4_2",
   "no": 4,
   "noLabel": {
    "zh": "四、"
   },
   "text": {
    "zh": "其他海事海商纠纷案件"
   }
  },
  {
   "id": "CN-JI-0168-A68",
   "no": 68,
   "noLabel": {
    "zh": "68、"
   },
   "text": {
    "zh": "船舶所有权、船舶优先权、船舶留置权、船舶抵押权等船舶物权纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A69",
   "no": 69,
   "noLabel": {
    "zh": "69、"
   },
   "text": {
    "zh": "港口货物、海运集装箱及港航设备设施的所有权、留置权、抵押权等物权纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A70",
   "no": 70,
   "noLabel": {
    "zh": "70、"
   },
   "text": {
    "zh": "海洋、通海可航水域开发利用设备设施等财产的所有权、留置权、抵押权等物权纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A71",
   "no": 71,
   "noLabel": {
    "zh": "71、"
   },
   "text": {
    "zh": "提单转让、质押所引起的纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A72",
   "no": 72,
   "noLabel": {
    "zh": "72、"
   },
   "text": {
    "zh": "海难救助纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A73",
   "no": 73,
   "noLabel": {
    "zh": "73、"
   },
   "text": {
    "zh": "海上、通海可航水域打捞清除纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A74",
   "no": 74,
   "noLabel": {
    "zh": "74、"
   },
   "text": {
    "zh": "共同海损纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A75",
   "no": 75,
   "noLabel": {
    "zh": "75、"
   },
   "text": {
    "zh": "港口作业纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A76",
   "no": 76,
   "noLabel": {
    "zh": "76、"
   },
   "text": {
    "zh": "海上、通海可航水域财产无因管理纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A77",
   "no": 77,
   "noLabel": {
    "zh": "77、"
   },
   "text": {
    "zh": "海运欺诈纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A78",
   "no": 78,
   "noLabel": {
    "zh": "78、"
   },
   "text": {
    "zh": "与航运经纪及航运衍生品交易相关的纠纷案件。"
   }
  },
  {
   "id": "CN-JI-0168-A5_2",
   "no": 5,
   "noLabel": {
    "zh": "五、"
   },
   "text": {
    "zh": "海事行政案件"
   }
  },
  {
   "id": "CN-JI-0168-A79",
   "no": 79,
   "noLabel": {
    "zh": "79、"
   },
   "text": {
    "zh": "因不服海事行政机关作出的涉及海上、通海可航水域或者港口内的船舶、货物、设备设施、海运集装箱等财产的行政行为而提起的行政诉讼案件；"
   }
  },
  {
   "id": "CN-JI-0168-A80",
   "no": 80,
   "noLabel": {
    "zh": "80、"
   },
   "text": {
    "zh": "因不服海事行政机关作出的涉及海上、通海可航水域运输经营及相关辅助性经营、货运代理、船员适任与上船服务等方面资质资格与合法性事项的行政行为而提起的行政诉讼案件；"
   }
  },
  {
   "id": "CN-JI-0168-A81",
   "no": 81,
   "noLabel": {
    "zh": "81、"
   },
   "text": {
    "zh": "因不服海事行政机关作出的涉及海洋、通海可航水域开发利用、渔业、环境与生态资源保护等活动的行政行为而提起的行政诉讼案件；"
   }
  },
  {
   "id": "CN-JI-0168-A82",
   "no": 82,
   "noLabel": {
    "zh": "82、"
   },
   "text": {
    "zh": "以有关海事行政机关拒绝履行上述第79项至第81项所涉行政管理职责或者不予答复而提起的行政诉讼案件；"
   }
  },
  {
   "id": "CN-JI-0168-A83",
   "no": 83,
   "noLabel": {
    "zh": "83、"
   },
   "text": {
    "zh": "以有关海事行政机关及其工作人员作出上述第79项至第81项行政行为或者行使相关行政管理职权损害合法权益为由，请求有关行政机关承担国家赔偿责任的案件；"
   }
  },
  {
   "id": "CN-JI-0168-A84",
   "no": 84,
   "noLabel": {
    "zh": "84、"
   },
   "text": {
    "zh": "以有关海事行政机关及其工作人员作出上述第79项至第81项行政行为或者行使相关行政管理职权影响合法权益为由，请求有关行政机关承担国家补偿责任的案件；"
   }
  },
  {
   "id": "CN-JI-0168-A85",
   "no": 85,
   "noLabel": {
    "zh": "85、"
   },
   "text": {
    "zh": "有关海事行政机关作出上述第79项至第81项行政行为而依法申请强制执行的案件。"
   }
  },
  {
   "id": "CN-JI-0168-A6_2",
   "no": 6,
   "noLabel": {
    "zh": "六、"
   },
   "text": {
    "zh": "海事特别程序案件"
   }
  },
  {
   "id": "CN-JI-0168-A86",
   "no": 86,
   "noLabel": {
    "zh": "86、"
   },
   "text": {
    "zh": "申请认定海事仲裁协议效力的案件；"
   }
  },
  {
   "id": "CN-JI-0168-A87",
   "no": 87,
   "noLabel": {
    "zh": "87、"
   },
   "text": {
    "zh": "申请承认、执行外国海事仲裁裁决，申请认可、执行香港特别行政区、澳门特别行政区、台湾地区海事仲裁裁决，申请执行或者撤销国内海事仲裁裁决的案件；"
   }
  },
  {
   "id": "CN-JI-0168-A88",
   "no": 88,
   "noLabel": {
    "zh": "88、"
   },
   "text": {
    "zh": "申请承认、执行外国法院海事裁判文书，申请认可、执行香港特别行政区、澳门特别行政区、台湾地区法院海事裁判文书的案件；"
   }
  },
  {
   "id": "CN-JI-0168-A89",
   "no": 89,
   "noLabel": {
    "zh": "89、"
   },
   "text": {
    "zh": "申请认定海上、通海可航水域财产无主的案件；"
   }
  },
  {
   "id": "CN-JI-0168-A90",
   "no": 90,
   "noLabel": {
    "zh": "90、"
   },
   "text": {
    "zh": "申请无因管理海上、通海可航水域财产的案件；"
   }
  },
  {
   "id": "CN-JI-0168-A91",
   "no": 91,
   "noLabel": {
    "zh": "91、"
   },
   "text": {
    "zh": "因海上、通海可航水域活动或者事故申请宣告失踪、宣告死亡的案件；"
   }
  },
  {
   "id": "CN-JI-0168-A92",
   "no": 92,
   "noLabel": {
    "zh": "92、"
   },
   "text": {
    "zh": "起诉前就海事纠纷申请扣押船舶、船载货物、船用物料、船用燃油或者申请保全其他财产的案件；"
   }
  },
  {
   "id": "CN-JI-0168-A93",
   "no": 93,
   "noLabel": {
    "zh": "93、"
   },
   "text": {
    "zh": "海事请求人申请财产保全错误或者请求担保数额过高引起的责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A94",
   "no": 94,
   "noLabel": {
    "zh": "94、"
   },
   "text": {
    "zh": "申请海事强制令案件；"
   }
  },
  {
   "id": "CN-JI-0168-A95",
   "no": 95,
   "noLabel": {
    "zh": "95、"
   },
   "text": {
    "zh": "申请海事证据保全案件；"
   }
  },
  {
   "id": "CN-JI-0168-A96",
   "no": 96,
   "noLabel": {
    "zh": "96、"
   },
   "text": {
    "zh": "因错误申请海事强制令、海事证据保全引起的责任纠纷案件；"
   }
  },
  {
   "id": "CN-JI-0168-A97",
   "no": 97,
   "noLabel": {
    "zh": "97、"
   },
   "text": {
    "zh": "就海事纠纷申请支付令案件；"
   }
  },
  {
   "id": "CN-JI-0168-A98",
   "no": 98,
   "noLabel": {
    "zh": "98、"
   },
   "text": {
    "zh": "就海事纠纷申请公示催告案件；"
   }
  },
  {
   "id": "CN-JI-0168-A99",
   "no": 99,
   "noLabel": {
    "zh": "99、"
   },
   "text": {
    "zh": "申请设立海事赔偿责任限制基金（含油污损害赔偿责任限制基金）案件；"
   }
  },
  {
   "id": "CN-JI-0168-A100",
   "no": 100,
   "noLabel": {
    "zh": "100、"
   },
   "text": {
    "zh": "与拍卖船舶或者设立海事赔偿责任限制基金（含油污损害赔偿责任限制基金）相关的债权登记与受偿案件；"
   }
  },
  {
   "id": "CN-JI-0168-A101",
   "no": 101,
   "noLabel": {
    "zh": "101、"
   },
   "text": {
    "zh": "与拍卖船舶或者设立海事赔偿责任限制基金（含油污损害赔偿责任限制基金）相关的确权诉讼案件；"
   }
  },
  {
   "id": "CN-JI-0168-A102",
   "no": 102,
   "noLabel": {
    "zh": "102、"
   },
   "text": {
    "zh": "申请从油污损害赔偿责任限制基金中代位受偿案件；"
   }
  },
  {
   "id": "CN-JI-0168-A103",
   "no": 103,
   "noLabel": {
    "zh": "103、"
   },
   "text": {
    "zh": "船舶优先权催告案件；"
   }
  },
  {
   "id": "CN-JI-0168-A104",
   "no": 104,
   "noLabel": {
    "zh": "104、"
   },
   "text": {
    "zh": "就海事纠纷申请司法确认调解协议案件；"
   }
  },
  {
   "id": "CN-JI-0168-A105",
   "no": 105,
   "noLabel": {
    "zh": "105、"
   },
   "text": {
    "zh": "申请实现以船舶、船载货物、船用物料、海运集装箱、港航设备设施、海洋开发利用设备设施等财产为担保物的担保物权案件；"
   }
  },
  {
   "id": "CN-JI-0168-A106",
   "no": 106,
   "noLabel": {
    "zh": "106、"
   },
   "text": {
    "zh": "地方人民法院为执行生效法律文书委托扣押、拍卖船舶案件；"
   }
  },
  {
   "id": "CN-JI-0168-A107",
   "no": 107,
   "noLabel": {
    "zh": "107、"
   },
   "text": {
    "zh": "申请执行海事法院及其上诉审高级人民法院和最高人民法院就海事纠纷作出的生效法律文书案件；"
   }
  },
  {
   "id": "CN-JI-0168-A108",
   "no": 108,
   "noLabel": {
    "zh": "108、"
   },
   "text": {
    "zh": "申请执行与海事纠纷有关的公证债权文书案件。"
   }
  },
  {
   "id": "CN-JI-0168-A7_2",
   "no": 7,
   "noLabel": {
    "zh": "七、"
   },
   "text": {
    "zh": "其他规定"
   }
  },
  {
   "id": "CN-JI-0168-A109",
   "no": 109,
   "noLabel": {
    "zh": "109、"
   },
   "text": {
    "zh": "本规定中的船舶工程系指船舶的建造、修理、改建、拆解等工程及相关的工程监理；本规定中的船舶关键部件和专用物品，系指舱盖板、船壳、龙骨、甲板、救生艇、船用主机、船用辅机、船用钢板、船用油漆等船舶主体结构、重要标志性部件以及专供船舶或者船舶工程使用的设备和材料。"
   }
  },
  {
   "id": "CN-JI-0168-A110",
   "no": 110,
   "noLabel": {
    "zh": "110、"
   },
   "text": {
    "zh": "当事人提起的民商事诉讼、行政诉讼包含本规定所涉海事纠纷的，由海事法院受理。"
   }
  },
  {
   "id": "CN-JI-0168-A111",
   "no": 111,
   "noLabel": {
    "zh": "111、"
   },
   "text": {
    "zh": "当事人就本规定中有关合同所涉事由引起的纠纷，以侵权等非合同诉由提起诉讼的，由海事法院受理。"
   }
  },
  {
   "id": "CN-JI-0168-A112",
   "no": 112,
   "noLabel": {
    "zh": "112、"
   },
   "text": {
    "zh": "法律、司法解释规定或者上级人民法院指定海事法院管辖其他案件的，从其规定或者指定。"
   }
  },
  {
   "id": "CN-JI-0168-A113",
   "no": 113,
   "noLabel": {
    "zh": "113、"
   },
   "text": {
    "zh": "本规定自2016年3月1日起施行。最高人民法院于2001年9月11日公布的《关于海事法院受理案件范围的若干规定》（法释〔2001〕27号）同时废止。"
   }
  },
  {
   "id": "CN-JI-0168-A114",
   "no": 114,
   "noLabel": {
    "zh": "114、"
   },
   "text": {
    "zh": "最高人民法院以前作出的有关规定与本规定不一致的，以本规定为准。"
   }
  }
 ],
