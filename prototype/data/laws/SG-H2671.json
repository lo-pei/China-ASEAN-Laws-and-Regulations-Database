   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order is the Infrastructure Protection (Protected Places) (No. 15) Order 2023 and comes into operation on 7 July 2023."
   }
  },
  {
   "id": "SG-H2671-A2",
   "no": 2,
