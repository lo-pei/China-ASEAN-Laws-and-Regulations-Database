   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order is the Infrastructure Protection (Protected Places) Order 2026 and comes into operation on 31 March 2026."
   }
  },
  {
   "id": "SG-H2744-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Premises declared to be protected places"
   },
   "text": {
    "en": "2. The premises described in the second column of the Schedule are declared to be protected places for the purposes of the Act, and the person specified in the first column of that Schedule is designated as the authority of the corresponding protected place."
   }
