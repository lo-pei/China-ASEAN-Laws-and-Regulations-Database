  {
   "id": "PH-H10388-A3",
   "no": 3,
   "noLabel": {
    "en": "Section 3."
   },
   "text": {
    "en": "Conduct and Supervision of Plebiscite. - The Commission on Elections (COMELEC) shall conduct and supervise the plebiscite to be held in Barangay 176 in the City of Caloocan within ninety (90) days from the effectivity of this Act.the expenses for such plebiscite shall be borne by the City of Caloocan."
   }
  },
  {
   "id": "PH-H10388-A4",
   "no": 4,
   "noLabel": {
    "en": "Section 4."
   },
   "text": {
    "en": "Appointment of Interim Barangay Officials. - There shall be a Punong Barangay, seven (7) Sangguniang Barangay Members, a Sangguniang Kabataan Chairman, and seven (7) Sangguniang Kabataan Members in each of the newly created barangays which shall be appointed by the Mayor. Such barangay officials shall serve until their successors shall have been duly elected and qualified."
   }
  },
  {
   "id": "PH-H10388-A5",
   "no": 5,
   "noLabel": {
    "en": "Section 5."
   },
   "text": {
    "en": "Incumbent Barangay Officials. -The incumbent barangay officials of Barangay 176 in the City of Caloocan shall continue to hold office until such time that the officials of the newly created barangays have been duly appointed."
   }
  },
  {
   "id": "PH-H10388-A6",
   "no": 6,
   "noLabel": {
    "en": "Section 6."
   },
   "text": {
    "en": "Public Infrastructure and Facilities. - All public infrastructure and facilities existing therein at the time of the approval of this Act are hereby transferred without cost or compensation to and shall be administered by the new barangays."
   }
  },
  {
   "id": "PH-H10388-A7",
   "no": 7,
   "noLabel": {
    "en": "Section 7."
   },
   "text": {
    "en": "National Tax Allotment (NTA) Shares. - All barangays herein created shall be entitled to the National Allotment shares pursuant to Section 285 of Republic Act No. 7160, as amended, otherwise known as the Local Government Code of 1991."
   }
  },
  {
   "id": "PH-H10388-A8",
   "no": 8,
   "noLabel": {
    "en": "Section 8."
   },
   "text": {
    "en": "Effectivity. - This Act shall take effect fifteen (15) days after its publication in the Official Gazette or in a newspaper of general circulation."
   }
  }
