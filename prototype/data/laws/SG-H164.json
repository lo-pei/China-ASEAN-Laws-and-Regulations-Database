   "text": {
    "en": "1. This Order is the Air Navigation (Protected Areas — Army Division Facilities) Order 2024 and comes into operation on 29 April 2024."
   }
  },
  {
   "id": "SG-H164-A2",
   "no": 2,
   "noLabel": {
