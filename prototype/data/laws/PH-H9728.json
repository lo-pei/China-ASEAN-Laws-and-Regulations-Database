  {
   "id": "PH-H9728-A3",
   "no": 3,
   "noLabel": {
    "en": "Section 3."
   },
   "text": {
    "en": "Conduct and Supervision of Plebiscite. — The plebiscite conducted and supervised by the Commission on Elections (COMELEC) in Barangay San Vicente pursuant to Sangguniang Panlalawigan Resolution No. 867, Series of 1997, and affirmed by Sangguniang Panlalawigan No. 358, Series of 2002 of the Province of Laguna, which ratified the creation of barangays San Vicente, Pacita I, Chrysanthemum, Rosario, Pacita II, Fatima, San Lorenzo Ruiz, and Maharlika as proclaimed by the Plebiscite Board of Canvassers on July 11, 2015, shall serve as substantial compliance with the plebiscite requirement under Section 10 of Republic Act No. 7160, as amended, otherwise known as the \"Local Government Code of 1991\"."
   }
  },
  {
   "id": "PH-H9728-A4",
   "no": 4,
   "noLabel": {
    "en": "Section 4."
   },
   "text": {
    "en": "Incumbent Barangay Officials. — The incumbent barangay officials shall continue to hold office until such time that their successors have been duly elected and qualified."
   }
  },
  {
   "id": "PH-H9728-A5",
   "no": 5,
   "noLabel": {
    "en": "Section 5."
   },
   "text": {
    "en": "Public Infrastructure and Facilities. -All existing public infrastructure and facilities for public use located in the different areas at the time of the approval of this Act are hereby transferred without cost or compensation to and shall be administered by the new barangays."
   }
  },
  {
   "id": "PH-H9728-A6",
   "no": 6,
   "noLabel": {
    "en": "Section 6."
   },
   "text": {
    "en": "Internal Revenue Allotment Shares. — All barangays herein created, namely: barangays San Vicente, Pacita I, Chrysanthemum, Rosario, Pacita II, Fatima, San Lorenzo Ruiz, and Maharlika in the City of San Pedro, Province of Laguna shall be entitled to Internal Revenue Allotment (IRA) shares pursuant to Section 285 of Republic Act No. 7160, as amended, otherwise known as the \"Local Government Code of 1991\"."
   }
  },
  {
   "id": "PH-H9728-A7",
   "no": 7,
   "noLabel": {
    "en": "Section 7."
   },
   "text": {
    "en": "Effectivity. — This Act shall take effect fifteen (15) days after its publication in the Official Gazette or in any newspaper of general circulation."
   }
  }
