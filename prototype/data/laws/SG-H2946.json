   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order may be cited as the Land Surveyors (Exemption) (No. 2) Order 2004 and shall come into operation on 1st March 2004."
   }
  },
  {
   "id": "SG-H2946-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Exemption"
   },
   "text": {
    "en": "2. Section 10 of the Act shall not apply to any person who carries out or causes to be carried out any hydrographic or hydrologic survey or other study of the waters and sea-bed within the territorial limits of Singapore for navigational purposes or studies of marine science and ecology."
   }
  }
