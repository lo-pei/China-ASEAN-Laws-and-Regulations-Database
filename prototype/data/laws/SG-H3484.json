   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order is the Parks and Trees (Marine Parks) (Exemption) Order 2024 and comes into operation on 28 October 2024."
   }
  },
  {
   "id": "SG-H3484-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Exemption for mooring of boats"
   },
   "text": {
    "en": "2. Regulation 13(1)(a) of the Parks and Trees Regulations (Rg 1) does not apply in relation to any boat that is moored at a public mooring in a marine park on any day starting 7 a.m. and ending 7 p.m."
   }
  }
