   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order is the Customs (Fuel Tank — Minimum Amount) Order 2019 and comes into operation on 1 April 2019."
   }
  },
  {
   "id": "SG-H1054-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Minimum amount of motor fuel for motor vehicles leaving Singapore"
   },
   "text": {
    "en": "2. For the purpose of section 136(1) of the Act, the minimum amount of motor fuel in each fuel supply tank of a motor vehicle is three‑quarters of the fuel supply tank."
   }
  },
  {
   "id": "SG-H1054-A3",
   "no": 3,
   "noLabel": {
    "en": "3."
   },
   "heading": {
    "en": "Revocation"
   },
   "text": {
    "en": "3. The Customs (Fuel Tank — Minimum Amount) Order 2011 (G.N. No. S 710/2011) is revoked."
   }
  }
 ]
