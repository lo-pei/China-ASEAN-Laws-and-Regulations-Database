   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order is the Medicines (Non‑Medicinal Products) Order 2023 and comes into operation on 18 December 2023."
   }
  },
  {
   "id": "SG-H3136-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Substances and articles that are not medicinal products for purposes of Act"
   },
   "text": {
    "en": "2. For the purposes of the Act, “medicinal product” does not include any substance or compound that is usable in the manufacture of a health product within the meaning given by section 2(1) of the Health Products Act 2007 as a pharmacologically active constituent."
   }
  },
