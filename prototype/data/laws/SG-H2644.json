   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order is the Infrastructure Protection (Protected Areas) Order 2020 and comes into operation on 18 April 2020."
   }
  },
  {
   "id": "SG-H2644-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Premises declared to be protected areas"
   },
   "text": {
    "en": "2. The premises described in the second column of the Schedule are declared to be protected areas for the purposes of the Act, and the person specified in the first column of that Schedule is designated as the authority of the corresponding protected area."
   }
