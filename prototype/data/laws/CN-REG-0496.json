 "articles": [
  {
   "id": "CN-REG-0496-A1",
   "no": 1,
   "noLabel": {
    "zh": "第一条"
   },
   "text": {
    "zh": "为了筹集社会资金，进行社会主义现代化建设，制定本条例。"
   }
  },
  {
   "id": "CN-REG-0496-A2",
   "no": 2,
   "noLabel": {
    "zh": "第二条"
   },
   "text": {
    "zh": "国库券的发行对象是：居民个人、个体工商户、企业、事业单位、机关、社会团体和其他组织。"
   }
  },
  {
   "id": "CN-REG-0496-A3",
   "no": 3,
   "noLabel": {
    "zh": "第三条"
   },
   "text": {
    "zh": "国库券以人民币元为计算单位。"
   }
  },
  {
   "id": "CN-REG-0496-A4",
   "no": 4,
   "noLabel": {
    "zh": "第四条"
   },
   "text": {
    "zh": "每年国库券的发行数额、利率、偿还期等，经国务院确定后，由财政部予以公告。"
   }
  },
  {
   "id": "CN-REG-0496-A5",
   "no": 5,
   "noLabel": {
    "zh": "第五条"
   },
   "text": {
    "zh": "国库券发行采取承购包销、认购等方式。\n国家下达的国库券发行计划，应当按期完成。"
   }
  },
  {
   "id": "CN-REG-0496-A6",
   "no": 6,
   "noLabel": {
    "zh": "第六条"
   },
   "text": {
    "zh": "国库券按期偿还本金。国库券利息在偿还本金时一次付给，不计复利。"
   }
  },
  {
   "id": "CN-REG-0496-A7",
   "no": 7,
   "noLabel": {
    "zh": "第七条"
   },
   "text": {
    "zh": "国库券的发行和还本付息事宜，在各级人民政府统一领导下，由财政部门和中国人民银行组织有关部门多渠道办理。"
   }
  },
  {
   "id": "CN-REG-0496-A8",
   "no": 8,
   "noLabel": {
    "zh": "第八条"
   },
   "text": {
    "zh": "国库券可以用于抵押，但是不得作为货币流通。"
   }
  },
  {
   "id": "CN-REG-0496-A9",
   "no": 9,
   "noLabel": {
    "zh": "第九条"
   },
   "text": {
    "zh": "国库券可以转让，但是应当在国家批准的交易场所办理。"
   }
  },
  {
   "id": "CN-REG-0496-A10",
   "no": 10,
   "noLabel": {
    "zh": "第十条"
   },
   "text": {
    "zh": "发行国库券筹集的资金，由国务院统一安排使用。"
   }
  },
  {
   "id": "CN-REG-0496-A11",
   "no": 11,
   "noLabel": {
    "zh": "第十一条"
   },
   "text": {
    "zh": "对伪造国库券的，依法追究刑事责任。\n对倒卖国库券的，按照投机倒把论处。(2011年1月8日删除)"
   }
  },
  {
   "id": "CN-REG-0496-A12",
   "no": 12,
   "noLabel": {
    "zh": "第十二条"
   },
   "text": {
    "zh": "国库券的利息收入享受免税待遇。"
   }
  },
  {
   "id": "CN-REG-0496-A13",
   "no": 13,
   "noLabel": {
    "zh": "第十三条"
   },
   "text": {
    "zh": "本条例由财政部负责解释。实施细则由财政部商中国人民银行制定。"
   }
  },
  {
   "id": "CN-REG-0496-A14",
   "no": 14,
   "noLabel": {
    "zh": "第十四条"
   },
   "text": {
    "zh": "本条例自发布之日起施行。"
   }
  }
 ],
