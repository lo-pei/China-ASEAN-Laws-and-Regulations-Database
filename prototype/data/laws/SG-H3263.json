   "text": {
    "en": "1. This Notification is the Multimodal Transport (ASEAN Member Country) Notification 2021."
   }
  },
  {
   "id": "SG-H3263-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "ASEAN member country"
   },
   "text": {
    "en": "2. The Minister declares the following countries as having ratified or acceded to the ASEAN Framework Agreement on Multimodal Transport:\n(a)Kingdom of Cambodia;\n(b)Kingdom of Thailand;\n(c)Lao People’s Democratic Republic;\n(d)Republic of Indonesia;\n(e)Republic of the Philippines;\n(f)Socialist Republic of Vietnam;\n(g)Union of Myanmar."
   }
