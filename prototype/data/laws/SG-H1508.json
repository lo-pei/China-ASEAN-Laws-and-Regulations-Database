   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order may be cited as the Fees (Recording of Fingerprint Impressions) Order 2011 and shall come into operation on 1st December 2011."
   }
  },
  {
   "id": "SG-H1508-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Fee"
   },
   "text": {
    "en": "2. There shall be payable to the Director, Criminal Investigation Department, Singapore, a fee of $15 for every set of fingerprint impressions recorded for and at the request of a member of the public."
   }
  }
