   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order may be cited as the Medicines (Cessation of Application of Act to Medical Devices) Order 2010 and shall come into operation on 10th August 2010."
   }
  },
  {
   "id": "SG-H3124-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Definition"
   },
   "text": {
    "en": "2. In this Order, “medical device” means a medical device referred to in the First Schedule to the Health Products Act (Cap. 122D)."
   }
  },
  {
   "id": "SG-H3124-A3",
   "no": 3,
   "noLabel": {
    "en": "3."
   },
   "heading": {
    "en": "Cessation of application of Act"
   },
   "text": {
    "en": "3. The provisions of the Act shall cease to apply to any medical device as from 10th August 2010."
   }
  }
 ]
