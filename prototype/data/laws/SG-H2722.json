   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order is the Infrastructure Protection (Protected Places) (No. 6) Order 2021 and comes into operation on 8 April 2021."
   }
  },
  {
   "id": "SG-H2722-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Premises declared to be protected place"
   },
   "text": {
    "en": "2. The premises described in the second column of the Schedule are declared to be a protected place for the purposes of the Act, and the person specified in the first column of that Schedule is designated as the authority of the protected place."
   }
  },
  {
   "id": "SG-H2722-A3",
   "no": 3,
   "noLabel": {
    "en": "3."
   },
   "heading": {
    "en": "Revocation"
   },
   "text": {
    "en": "3. The Protected Places (No. 9) Order 2015 (G.N. No. S 743/2015) is revoked."
   }
  },
