  {
   "id": "SG-H3090-A1",
   "no": 1,
   "noLabel": {
    "en": "1."
   },
   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Notification may be cited as the Maritime and Port Authority of Singapore (Port Limits) Notification 2010 and shall come into operation on 20th April 2010."
   }
  },
  {
   "id": "SG-H3090-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Port limits"
   },
   "text": {
    "en": "2. The waters within the limits described in the Schedule and any place or premises which is under the control of or used by the Authority for the purpose of carrying out its duties or functions are declared to be a port for the purposes of the Act."
   }
  },
  {
   "id": "SG-H3090-A3",
   "no": 3,
   "noLabel": {
    "en": "3."
   },
   "heading": {
    "en": "Cancellation"
   },
   "text": {
    "en": "3. The Maritime and Port Authority of Singapore (Port Limits) Notification 2006 (G.N. No. S 280/2006) is cancelled."
   }
  },
