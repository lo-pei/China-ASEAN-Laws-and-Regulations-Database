   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Notification may be cited as the Limited Partnerships (Direction under section 17A(1)(d)) Notification 2015 and comes into operation on 3 January 2016."
   }
  },
  {
   "id": "SG-H3030-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Direction under section 17A(1)(d) of Act"
   },
   "text": {
    "en": "2. The Minister directs that the Registrar must not accept for registration under the Act any name containing the word “Temasek” unless Temasek Holdings (Private) Limited (Registration No. 197401143C) is a general partner of the limited partnership."
   }
  },
  {
   "id": "SG-H3030-A3",
   "no": 3,
   "noLabel": {
    "en": "3."
   },
   "heading": {
    "en": "Cancellation"
   },
   "text": {
    "en": "3. The Limited Partnerships (Restriction on Registration of Name) Notification (N 1) is cancelled."
   }
  }
 ]
