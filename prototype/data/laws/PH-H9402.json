  {
   "id": "PH-H9402-A4",
   "no": 4,
   "noLabel": {
    "en": "Section 4."
   },
   "text": {
    "en": "Seat of the Municipal Government. - The seat of the municipal government shall be at Poblacion, Barangay Cabaritan."
   }
  },
  {
   "id": "PH-H9402-A5",
   "no": 5,
   "noLabel": {
    "en": "Section 5."
   },
   "text": {
    "en": "Conduct and Supervision of Plebiscite. - The Commission on Elections (COMELEC) shall conduct and supervise the plebiscite to be held in the entire Municipality of Dumalneg, Province of Ilocos Norte not later than one hundred twenty (120) days from the effectivity of this Act."
   }
  },
  {
   "id": "PH-H9402-A6",
   "no": 6,
   "noLabel": {
    "en": "Section 6."
   },
   "text": {
    "en": "Barangay Officials. - The first set of officials of the barangays shall be appointed by the provincial governor, in consultation with the Representative of the District, and shall hold office until such time that their successors have been duly elected and qualified."
   }
  },
  {
   "id": "PH-H9402-A7",
   "no": 7,
   "noLabel": {
    "en": "Section 7."
   },
   "text": {
    "en": "Public Infrastructure and Facilities. - All public infrastructure and facilities for public use existing therein at the time of the approval of this Act are hereby transferred without cost or compensation to and shall be administered by the new barangays."
   }
  },
  {
   "id": "PH-H9402-A8",
   "no": 8,
   "noLabel": {
    "en": "Section 8."
   },
   "text": {
    "en": "Internal Revenue Allotment Shares. - The Municipality of Dumalneg and all the barangays herein created shall be entitled to Internal Revenue Allotment (IRA) shares pursuant to Section 285 of Republic Act No. 7160, as amended, otherwise known as the \"Local Government Code of 1991\"."
   }
  },
  {
   "id": "PH-H9402-A9",
   "no": 9,
   "noLabel": {
    "en": "Section 9."
   },
   "text": {
    "en": "Effectivity. - This Act shall take effect fifteen (15) days after its publication in the Official Gazette or in a newspaper of general circulation."
   }
  }
