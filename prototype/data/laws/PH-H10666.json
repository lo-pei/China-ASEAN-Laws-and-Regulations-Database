  {
   "id": "PH-H10666-A3",
   "no": 3,
   "noLabel": {
    "en": "Section 3."
   },
   "text": {
    "en": "Conduct and Supervision of Plebiscite. - The plebiscite conducted and supervised by the Commission on Elections pursuant to Sangguniang Panlalawigan Ordinance No. 2002-010 dated September 25, 2002, which was duly ratified and proclaimed by the Plebiscite Board of Canvassers on February 4, 2003, shall serve as substantial compliance with the plebiscite requirement under Section 10 of Republic Act No. 7160, as amended, otherwise known as the Local Government Code of 1991."
   }
  },
  {
   "id": "PH-H10666-A4",
   "no": 4,
   "noLabel": {
    "en": "Section 4."
   },
   "text": {
    "en": "Incumbent Barangay Officials. - The incumbent elected barangay officials of Barangay Pulung Bulu shall continue to hold office until such time that their successors have been duly elected and qualified."
   }
  },
  {
   "id": "PH-H10666-A5",
   "no": 5,
   "noLabel": {
    "en": "Section 5."
   },
   "text": {
    "en": "Public Infrastructure and Facilities. - All public infrastructure and facilities existing therein at the time of the approval of this Act are hereby transferred without cost or compensation to and shall be administered by the new barangay."
   }
  },
  {
   "id": "PH-H10666-A6",
   "no": 6,
   "noLabel": {
    "en": "Section 6."
   },
   "text": {
    "en": "National Tax Allotment Shares. - Barangay Pulung Bulu shall be entitled to National Tax Allotment shares pursuant to Section 285 of the Local Government Code of 1991, as amended."
   }
  },
  {
   "id": "PH-H10666-A7",
   "no": 7,
   "noLabel": {
    "en": "Section 7."
   },
   "text": {
    "en": "Repealing Clause. - All laws, decrees, executive orders, rules and regulations which are inconsistent with this Act are hereby repealed or modified accordingly."
   }
  },
  {
   "id": "PH-H10666-A8",
   "no": 8,
   "noLabel": {
    "en": "Section 8."
   },
   "text": {
    "en": "Effectivity. - This Act shall take effect after fifteen (15) days after its publication in the Official Gazette or in a national newspaper of general circulation."
   }
  }
 ]
