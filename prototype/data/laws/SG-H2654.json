   "heading": {
    "en": "Citation and commencement"
   },
   "text": {
    "en": "1. This Order is the Infrastructure Protection (Protected Places) (No. 11) Order 2021 and comes into operation on 15 October 2021."
   }
  },
  {
   "id": "SG-H2654-A2",
   "no": 2,
   "noLabel": {
    "en": "2."
   },
   "heading": {
    "en": "Premises declared to be protected place"
   },
   "text": {
    "en": "2. The premises described in the second column of the Schedule are declared to be a protected place for the purposes of the Act, and the person specified in the first column of that Schedule is designated as the authority of the protected place."
   }
  },
  {
   "id": "SG-H2654-A3",
   "no": 3,
   "noLabel": {
    "en": "3."
   },
   "heading": {
    "en": "Revocation"
   },
   "text": {
    "en": "3. Item (2) of the Schedule to the Protected Places (Consolidation) Order (O 14) is deleted."
   }
  },
