  {
   "id": "PH-H9403-A3",
   "no": 3,
   "noLabel": {
    "en": "Section 3."
   },
   "text": {
    "en": "Conduct and Supervision of Plebiscite. - The plebiscite conducted and supervised by the Commission on Elections (COMELEC) on March 14, 1993 pursuant to Provincial Ordinance No. 2, Series of 1991, dated September 5, 1991 of the Sangguniang Panlalawigan of the Province of Tarlac, which ratified the creation of Barangay Care, shall serve as substantial compliance with the plebiscite requirement under Section 10 of Republic Act No. 7160, as amended, otherwise known as the \"Local Government Code of 1991\"."
   }
  },
  {
   "id": "PH-H9403-A4",
   "no": 4,
   "noLabel": {
    "en": "Section 4."
   },
   "text": {
    "en": "Incumbent Barangay Officials. - The incumbent barangay officials of Barangay Care shall continue to hold office until such time that their successors have been duly elected and qualified."
   }
  },
  {
   "id": "PH-H9403-A5",
   "no": 5,
   "noLabel": {
    "en": "Section 5."
   },
   "text": {
    "en": "Public Infrastructure and Facilities. - All public infrastructure and facilities for public use existing therein at the time of the approval of this Act are hereby transferred without cost or compensation to and shall be administered by the new barangay."
   }
  },
  {
   "id": "PH-H9403-A6",
   "no": 6,
   "noLabel": {
    "en": "Section 6."
   },
   "text": {
    "en": "Internal Revenue Allotment Shares. - Barangay Care shall be entitled to Internal Revenue Allotment (IRA) shares pursuant to Section 285 of Republic Act No. 7160, as amended, otherwise known as the \"Local Government Code of 1991\"."
   }
  },
  {
   "id": "PH-H9403-A7",
   "no": 7,
   "noLabel": {
    "en": "Section 7."
   },
   "text": {
    "en": "Effectivity. - This Act shall take effect fifteen (15) days after its publication in the Official Gazette or in a newspaper of general circulation."
   }
  }
