   "id": "PH-H9918-A1",
   "no": 1,
   "noLabel": {
    "en": "Section 1."
   },
   "text": {
    "en": "The road network connecting Barangay Grijalvo in the Municipality of San Fernando and the Municipality of Bula, Province of Camarines Sur, is hereby converted into a national road."
   }
  },
  {
   "id": "PH-H9918-A2",
   "no": 2,
   "noLabel": {
    "en": "Section 2."
   },
   "text": {
    "en": "The Secretary of Public Works and Highways shall include in the Department's program the improvement, repair, and maintenance of said road, the funding of which shall be included in the annual General Appropriations Act."
   }
  },
